APP_NAME="NewDay Ops Portal Beta"
APP_ENV=beta
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
PAYMENTS_LIVE_ENABLED=false
PAYMENTS_FAKE_PROVIDER=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/beta.sqlite
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

BETA_DEMO_PASSWORD=replace-with-a-local-only-password
FILESYSTEM_DISK=local
FIELD_MEDIA_DISK=local

OPS_READY_HANDOFF_WARNING_HOURS=24
OPS_ACTIVE_VISIT_WARNING_HOURS=24
OPS_CLOSEOUT_WARNING_HOURS=48
