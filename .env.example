APP_NAME="NewDay Tech Ops Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FIELD_TEST_DESTRUCTIVE_PURGE_ENABLED=false
PAYMENTS_LIVE_ENABLED=false
SQUARE_SANDBOX_APPLICATION_ID=
SQUARE_SANDBOX_APPLICATION_SECRET=
SQUARE_SANDBOX_WEBHOOK_SIGNATURE_KEY=
SQUARE_PRODUCTION_APPLICATION_ID=
SQUARE_PRODUCTION_APPLICATION_SECRET=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
STRIPE_TEST_CONNECT_CLIENT_ID=
STRIPE_TEST_PLATFORM_SECRET=
STRIPE_TEST_CONNECT_WEBHOOK_SECRET=
STRIPE_LIVE_CONNECT_CLIENT_ID=
STRIPE_LIVE_PLATFORM_SECRET=
STRIPE_LIVE_CONNECT_WEBHOOK_SECRET=
PAYMENTS_FAKE_PROVIDER=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

HASH_DRIVER=argon2id

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=newday_ops
DB_USERNAME=newday
DB_PASSWORD=newday_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FIELD_MEDIA_DISK=local
SERVICE_TICKET_FILE_DISK=local
PROJECT_ATTACHMENT_DISK=local
ORGANIZATION_BRANDING_DISK=local
QUEUE_CONNECTION=database

OPS_READY_HANDOFF_WARNING_HOURS=24
OPS_ACTIVE_VISIT_WARNING_HOURS=24
OPS_CLOSEOUT_WARNING_HOURS=48

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
