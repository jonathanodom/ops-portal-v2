{
  "info": {
    "name": "Ops Portal v2 — /api/v1 (JARVIS boundary)",
    "description": "Covers OP-API-1 (auth/scopes), OP-API-2 (customers, contacts, locations), and OP-API-3 (tickets + idempotency) from docs/OPS_PORTAL_API_IMPLEMENTATION_PLAN_CODEX_v0.1.md.\n\nSetup:\n1. Pull feat/op-api-1-foundation-and-service-identity locally and `composer install` (adds laravel/sanctum — required or the whole app 500s).\n2. composer phase:update (or migrate) so the new tables/capabilities/role exist.\n3. php artisan jarvis:create-service-account (prints a one-time bearer token).\n4. Import the companion environment file, set `token` to that value, and select it.\n5. Run 'Happy path' top to bottom, then 'Tickets (C-006/C-007)' top to bottom (it depends on customer_id/location_id/contact_id captured by Happy path), then 'Negative cases'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://ops-portal-v2.test/api/v1" },
    { "key": "token", "value": "" },
    { "key": "customer_id", "value": "1" },
    { "key": "location_id", "value": "1" },
    { "key": "contact_id", "value": "1" },
    { "key": "idempotency_key", "value": "" },
    { "key": "ticket_id", "value": "" }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "GET /me — confirm identity and scopes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has actor + scopes', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.actor).to.have.property('id');",
                  "  pm.expect(body.data.scopes).to.be.an('array');",
                  "  pm.expect(body.meta.request_id).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        },
        {
          "name": "GET /customers/search?q=... — find a customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array of CustomerSummary', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  if (body.data.length) {",
                  "    pm.expect(body.data[0]).to.have.all.keys('id', 'name', 'status', 'primary_phone', 'primary_email');",
                  "    pm.collectionVariables.set('customer_id', body.data[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/customers/search?q=T%26S&limit=20",
              "host": ["{{base_url}}"],
              "path": ["customers", "search"],
              "query": [
                { "key": "q", "value": "T%26S" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /customers/{{customer_id}} — customer detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('shape matches CustomerSummary', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.all.keys('id', 'name', 'status', 'primary_phone', 'primary_email');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}"]
            }
          }
        },
        {
          "name": "GET /customers/{{customer_id}}/locations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array of LocationSummary', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  if (body.data.length) {",
                  "    pm.expect(body.data[0]).to.have.all.keys('id', 'customer_id', 'name', 'address', 'timezone');",
                  "    pm.expect(body.data[0].address).to.have.all.keys('line1', 'line2', 'city', 'state', 'postal_code');",
                  "    pm.collectionVariables.set('location_id', body.data[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/customers/{{customer_id}}/locations",
              "host": ["{{base_url}}"],
              "path": ["customers", "{{customer_id}}", "locations"]
            }
          }
        },
        {
          "name": "GET /contacts/search?q=...",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array of ContactSummary', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  if (body.data.length) {",
                  "    pm.expect(body.data[0]).to.have.all.keys('id', 'customer_id', 'name', 'phones', 'emails');",
                  "    pm.expect(body.data[0].phones).to.be.an('array');",
                  "    pm.collectionVariables.set('contact_id', body.data[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/contacts/search?q=Ken&limit=20",
              "host": ["{{base_url}}"],
              "path": ["contacts", "search"],
              "query": [
                { "key": "q", "value": "Ken" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tickets (C-006/C-007)",
      "item": [
        {
          "name": "GET /tickets?customer_id=... — before create (expect none open)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tickets?customer_id={{customer_id}}&status=open",
              "host": ["{{base_url}}"],
              "path": ["tickets"],
              "query": [
                { "key": "customer_id", "value": "{{customer_id}}" },
                { "key": "status", "value": "open" }
              ]
            }
          }
        },
        {
          "name": "POST /tickets — create (with Idempotency-Key)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('idempotency_key')) {",
                  "  pm.collectionVariables.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('shape matches Ticket DTO', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.have.all.keys('id', 'ticket_number', 'customer_id', 'location_id', 'contact_id', 'title', 'description', 'customer_visible_summary', 'priority', 'source', 'purpose', 'billing_disposition', 'status', 'created_at', 'updated_at');",
                  "  pm.expect(body.data.status).to.eql('open');",
                  "  pm.collectionVariables.set('ticket_id', body.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": {{customer_id}},\n  \"location_id\": {{location_id}},\n  \"contact_id\": {{contact_id}},\n  \"title\": \"Front office phones rebooting\",\n  \"description\": \"Customer reports intermittent phone reboots.\",\n  \"priority\": \"normal\",\n  \"source\": \"jarvis\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        },
        {
          "name": "GET /tickets/{{ticket_id}} — confirm it's retrievable",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('matches the created ticket', () => pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('ticket_id')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}", "host": ["{{base_url}}"], "path": ["tickets", "{{ticket_id}}"] }
          }
        },
        {
          "name": "POST /tickets — replay same Idempotency-Key → same ticket, no duplicate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created (replayed result)', () => pm.response.to.have.status(201));",
                  "pm.test('same ticket id as the first create', () => {",
                  "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('ticket_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": {{customer_id}},\n  \"location_id\": {{location_id}},\n  \"contact_id\": {{contact_id}},\n  \"title\": \"Front office phones rebooting\",\n  \"description\": \"Customer reports intermittent phone reboots.\",\n  \"priority\": \"normal\",\n  \"source\": \"jarvis\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] },
            "description": "Uses the SAME idempotency_key collection variable as the previous request on purpose — this is the replay test. Re-running this request alone (without re-running 'create' first) is exactly the scenario it proves."
          }
        },
        {
          "name": "GET /tickets?customer_id=... — after create (expect 1 open)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('exactly one open ticket, matching the created one', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.length).to.eql(1);",
                  "  pm.expect(data[0].id).to.eql(pm.collectionVariables.get('ticket_id'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/tickets?customer_id={{customer_id}}&status=open",
              "host": ["{{base_url}}"],
              "path": ["tickets"],
              "query": [
                { "key": "customer_id", "value": "{{customer_id}}" },
                { "key": "status", "value": "open" }
              ]
            },
            "description": "Confirms exactly ONE open ticket exists even though the create request above ran twice with the same Idempotency-Key."
          }
        },
        {
          "name": "POST /tickets without Idempotency-Key → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('idempotency_key_required envelope', () => pm.expect(pm.response.json().error.code).to.eql('idempotency_key_required'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": {{customer_id}},\n  \"location_id\": {{location_id}},\n  \"title\": \"Should not be created\",\n  \"priority\": \"normal\",\n  \"source\": \"jarvis\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        },
        {
          "name": "POST /tickets with missing title → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('validation error mentions title', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('validation_failed');",
                  "  pm.expect(body.error.details).to.have.property('title');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": {{customer_id}},\n  \"location_id\": {{location_id}},\n  \"priority\": \"normal\",\n  \"source\": \"jarvis\"\n}"
            },
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] }
          }
        }
      ]
    },
    {
      "name": "Negative cases",
      "item": [
        {
          "name": "GET /me with no token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('error envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('unauthenticated');",
                  "  pm.expect(body.meta.request_id).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        },
        {
          "name": "GET /me with garbage token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('error envelope', () => pm.expect(pm.response.json().error.code).to.eql('unauthenticated'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "not-a-real-token", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        },
        {
          "name": "GET /customers/search with no q → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('validation error envelope', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('validation_failed');",
                  "  pm.expect(body.error.details).to.have.property('q');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/customers/search", "host": ["{{base_url}}"], "path": ["customers", "search"] }
          }
        },
        {
          "name": "GET /customers/999999999 → 404 (no internal detail leaked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('generic message, no class names', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('not_found');",
                  "  pm.expect(body.error.message).to.eql('The requested resource was not found.');",
                  "  pm.expect(pm.response.text()).to.not.include('App\\\\Models');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/customers/999999999",
              "host": ["{{base_url}}"],
              "path": ["customers", "999999999"]
            }
          }
        },
        {
          "name": "GET /customers/search with a tickets-only token → 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                  "pm.test('forbidden envelope', () => pm.expect(pm.response.json().error.code).to.eql('forbidden'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{narrow_token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/customers/search?q=anything",
              "host": ["{{base_url}}"],
              "path": ["customers", "search"],
              "query": [{ "key": "q", "value": "anything" }]
            },
            "description": "Optional: set the `narrow_token` collection variable to a token created with only ['tickets.read'] abilities (e.g. `php artisan tinker` → `User::find(1)->createToken('narrow', ['tickets.read'])->plainTextToken`) to exercise the insufficient-scope path. Skip this request if you haven't created one."
          }
        }
      ]
    }
  ]
}
